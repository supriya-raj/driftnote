{
  "name": "driftnote",
  "private": true,
  "description": "Local-first, real-time collaborative notes",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "e2e": "pnpm --filter @driftnote/web e2e",
    "e2e:all": "pnpm --filter @driftnote/web e2e:all"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
